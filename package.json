{
  "name": "workforce",
  "version": "0.1.0",
  "private": true,
  "description": "Run a small team of Claude Code agents on your GitHub projects, from one dashboard.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "server": "tsx server/main.ts",
    "dev": "tsx watch server/main.ts",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "vitest run",
    "build:web": "npm --prefix web run build"
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "@fastify/websocket": "11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.8",
    "node-pty": "1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
